# Token gratuito: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# IDs das ligas ativas (virgula). BSA = Brasileirao, CL = Champions, CLI = Libertadores
ACTIVE_LEAGUES=BSA

# Destino Google Sheets (opcional). Deixe vazio para gerar so CSV/SQLite.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/service_account.json

# Timezone usada nos relatorios
APP_TIMEZONE=America/Sao_Paulo
SEASON=
